# Copy this file to .env and fill in real values for your environment.
# Never commit .env — see 00_Development_Standards/Git_Strategy.md §8.
# Naming follows 00_Development_Standards/Naming_Conventions.md §5.

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL — see 02_Architecture/Technical_Architecture.md) ---
# Defaults below match the local docker-compose service in 07_DevOps/Docker.md.
DB_NAME=int_projects_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- CORS (django-cors-headers) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CSRF (django.contrib.admin's session+cookie login only — the JSON API
# itself is JWT-bearer authenticated and unaffected by this) ---
# Leave blank in local dev. In a real deployment, set to the exact full
# origin(s) (scheme + host, comma-separated, no trailing slash) that serve
# admin over HTTPS — never a wildcard. Example values only, not real hosts:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Object Storage (BE-078) ---
# Leave STORAGE_BACKEND unset (or "local") for development -- files go to
# ./media (public) and ./media_private (private, never served by nginx),
# no AWS credentials needed. Set STORAGE_BACKEND=s3 in a real deployment;
# the four AWS_* variables below then become required (Django refuses to
# boot without all four -- see config/settings.py). AWS_S3_ENDPOINT_URL is
# only needed for a non-AWS S3-compatible provider (MinIO, DigitalOcean
# Spaces, Cloudflare R2, ...); AWS_S3_CUSTOM_DOMAIN is only needed if a CDN
# fronts the public bucket. Never commit real values here.
STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_SIGNED_URL_EXPIRE_SECONDS=3600

# --- Celery & Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Logging ---
DJANGO_LOG_LEVEL=INFO

# --- Production-only (ignored when DJANGO_DEBUG=true) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

