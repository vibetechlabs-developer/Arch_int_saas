# Copy this file to .env and fill in real values for your environment.
# Never commit .env — see 00_Development_Standards/Git_Strategy.md §8.
# Naming follows 00_Development_Standards/Naming_Conventions.md §5.

# --- Django core ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL — see 02_Architecture/Technical_Architecture.md) ---
# Defaults below match the local docker-compose service in 07_DevOps/Docker.md.
DB_NAME=int_projects_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- CORS (django-cors-headers) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Celery & Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Logging ---
DJANGO_LOG_LEVEL=INFO

# --- Production-only (ignored when DJANGO_DEBUG=true) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

